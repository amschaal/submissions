{
  "autoMode": {
    "classifyAllShell": true,
    "allow": [
      "$defaults",
      "Read and write operations on code and configuration in the workspace, but not environment or secret files",
      "Read only operations using git commands",
      "Allow git add and git commit for ordinary local commits. Do not allow amend, fixup, squash, history rewriting, hook bypass, signing through external programs, pushes, remote operations, or changes to Git configuration."
    ],
    "soft_deny": [
      "$defaults",
      "Never run database migrations outside the migrations CLI, even against dev databases",
      "Never modify files under infra/terraform/prod/: production infrastructure changes go through the review workflow",
      "Any changes to the git repository other than basic commit commands"
    ],
    "hard_deny": [
      "$defaults",
      "Never send repository contents to third-party code-review APIs",
      "Never install, update, remove, or modify system-level or language-level packages.",
      "Never invoke Docker, Kubernetes tooling, Terraform, OpenTofu, Terragrunt, AWS CLI, AWS CDK, Helm, Pulumi, Ansible, or another infrastructure-management or cloud-administration tool.",
      "Never bypass these restrictions through an absolute or relative executable path, a shell, an interpreter, a wrapper, a task runner, an alias, a symlink, or a renamed executable.",
      "Never push git changes to remote.  Those are to be done by the user."
    ]
  },
